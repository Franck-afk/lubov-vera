<?xml version="1.0"?>
<ruleset name="Lubov Vera">
	<description>WordPress Coding Standards for the lubov-vera theme and lubov-vera-core plugin.</description>

	<file>themes/lubov-vera</file>
	<file>themes/lubov-vera-child</file>
	<file>plugins/lubov-vera-core</file>
	<file>plugins/quote-block</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/img/*</exclude-pattern>
	<exclude-pattern>*/assets/fonts/*</exclude-pattern>
	<exclude-pattern>*/plugins/quote-block/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
